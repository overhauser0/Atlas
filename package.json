{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "gleis",
    "trails"
  ],
  "scripts": {
    "dev:gleis": "npm run dev --workspace=gleis",
    "dev:trails": "npm run dev --workspace=trails",
    "build:gleis": "npm run build --workspace=gleis",
    "build:trails": "npm run build --workspace=trails",
    "typecheck:gleis": "tsc -p gleis/tsconfig.json --noEmit",
    "typecheck:trails": "tsc -p trails/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:gleis && npm run typecheck:trails"
  }
}
